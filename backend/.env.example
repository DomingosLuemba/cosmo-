ANTHROPIC_API_KEY=
PORT=3000

# APNs (push notifications) — necessário para acordar o app em background
# e para as notificações de aprovação. Deixe em branco em desenvolvimento;
# approval/push.ts apenas loga quando essas variáveis não estão presentes.
# As quatro precisam estar preenchidas para o envio real acontecer.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
# Caminho para a chave .p8 baixada em developer.apple.com (Keys → APNs).
APNS_PRIVATE_KEY_PATH=

# sandbox (padrão) para builds de debug do Xcode; production para
# TestFlight/App Store. O ambiente errado devolve "BadDeviceToken".
APNS_ENV=sandbox
