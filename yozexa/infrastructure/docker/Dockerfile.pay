# YOZEXA Pay image.

FROM node:22-bookworm-slim AS build
WORKDIR /src

COPY package.json package-lock.json* ./
COPY sdk/typescript/package.json ./sdk/typescript/
COPY indexer/package.json ./indexer/
COPY pay/package.json ./pay/
RUN npm ci --omit=dev --ignore-scripts || npm install --omit=dev --ignore-scripts

COPY sdk/typescript/ ./sdk/typescript/
COPY indexer/ ./indexer/
COPY pay/ ./pay/
RUN npm install --ignore-scripts \
 && npm run build --workspace @yozexa/sdk \
 && npm run build --workspace @yozexa/indexer \
 && npm run build --workspace @yozexa/pay \
 && npm prune --omit=dev

FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production

COPY --from=build /src/node_modules ./node_modules
COPY --from=build /src/sdk ./sdk
COPY --from=build /src/indexer ./indexer
COPY --from=build /src/pay ./pay
COPY --from=build /src/package.json ./package.json

# Runs unprivileged. Every secret — DATABASE_URL, WEBHOOK_SIGNING_KEY — comes
# from the environment at run time, never from a layer.
USER node
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s \
  CMD node -e "fetch('http://127.0.0.1:8080/v1/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "pay/dist/src/server.js"]
